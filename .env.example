PROJECT_NAME="Wish2Luv API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
# Keep this False anywhere but your own machine: it turns on SQL echo (every
# letter body ends up in the logs), uvicorn auto-reload, and it forces auth
# cookies to non-Secure so they work over plain http.
DEBUG=False

# Database. A plain postgresql:// URL is fine -- the app adapts it per driver
# (asyncpg for the app, psycopg2 for Alembic) and strips libpq-only params
# such as sslmode, which asyncpg rejects.
#   Postgres: postgresql://user:password@host:5432/dbname?sslmode=disable
#   SQLite:   sqlite+aiosqlite:///./wish2love.db
# A '@' inside the password must be percent-encoded as %40.
DATABASE_URL="postgresql://user:password@localhost:5432/wish2love"

# Local file upload directory
UPLOAD_DIR="./uploads"

# Public base URLs. PUBLIC_APP_URL builds the /l/<slug> share link that goes
# out in email/SMS; PUBLIC_API_URL makes uploaded photo URLs absolute.
PUBLIC_APP_URL="http://localhost:8080"
PUBLIC_API_URL="http://localhost:8000"

# Every origin allowed to call the API, listed explicitly. "*" is rejected at
# startup: this API sends credentials, and a wildcard would let any site on the
# internet make authenticated calls with a visitor's session.
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173","https://wish2luv.com","https://www.wish2luv.com"]

# ---- auth ----
# Must be at least 32 bytes. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="change-me-to-a-long-random-string-at-least-32-bytes"
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# COOKIE_SECURE=True in production (HTTPS only). When the frontend is on a
# different origin than the API, SameSite must be "none" -- which browsers only
# honour on a Secure cookie, so the two go together.
COOKIE_SECURE=True
COOKIE_SAMESITE="none"
COOKIE_DOMAIN=""

# Google OAuth: console.cloud.google.com -> Credentials -> OAuth client ID
# Authorised redirect URI: <PUBLIC_API_URL>/api/v1/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# GitHub OAuth: github.com/settings/developers
# Callback: <PUBLIC_API_URL>/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---- pricing ----
# What one letter costs. Orders are recorded at this price with status
# "Pending"; no payment gateway is wired up yet, so nothing moves them to Paid.
LETTER_PRICE=4.99
LETTER_CURRENCY="USD"

# ---- integrations ----
# Seven.io -- SMS + voice delivery. Dashboard: https://www.seven.io/ (API key
# under Developer > API keys). Leave blank to skip sending entirely.
SEVEN_API_KEY=""

# SMTP -- password resets, admin invitations and "email" letter delivery.
# Brevo's free tier is 300/day. Both USER and PASSWORD must be set or email
# is skipped and the link is written to the log instead.
SMTP_HOST="smtp-relay.brevo.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
MAIL_FROM="Wish2Luv <no-reply@wish2luv.com>"

# Cloudflare Turnstile -- captcha on register and login. Free and unmetered.
# Leave blank to disable the check (the frontend hides the widget to match).
TURNSTILE_SECRET_KEY=""

# Redis -- required before running more than one worker: the rate limiter and
# the OAuth state map are in-process today, so each worker keeps its own copy.
# Not yet read by the app; see app/core/deps.py and app/modules/auth/router.py.
REDIS_URL=""
