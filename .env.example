PROJECT_NAME="LoveAssets API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database. A plain postgresql:// URL is fine -- the app adapts it per driver
# (asyncpg for the app, psycopg2 for Alembic) and strips libpq-only params
# such as sslmode, which asyncpg rejects.
#   Postgres: postgresql://user:password@host:5432/dbname?sslmode=disable
#   SQLite:   sqlite+aiosqlite:///./loveassets.db
# A '@' inside the password must be percent-encoded as %40.
DATABASE_URL="postgresql://user:password@localhost:5432/loveassets"

# Local file upload directory
UPLOAD_DIR="./uploads"

# Public base URLs. PUBLIC_APP_URL builds the /l/<slug> share link that goes
# out in SMS; PUBLIC_API_URL makes uploaded photo URLs absolute.
PUBLIC_APP_URL="http://localhost:8080"
PUBLIC_API_URL="http://localhost:8000"

# CORS origins ("*" allows all origins)
CORS_ORIGINS=["*"]

# Seven.io -- SMS and voice delivery. Leave blank to skip sending.
SEVEN_API_KEY=""
