PROJECT_NAME="LoveAssets API"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True

# Database configuration (Async SQLite by default)
DATABASE_URL="sqlite+aiosqlite:///./loveassets.db"

# Local file upload directory
UPLOAD_DIR="./uploads"

# CORS origins ("*" allows all origins)
CORS_ORIGINS=["*"]
